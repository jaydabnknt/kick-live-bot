// Cloudflare settings for the Kick live alerts bot.
// Cloudflare reads this on every automatic deploy, so the worker always matches it.
// Secrets (BOT_TOKEN, KICK_CLIENT_ID, KICK_CLIENT_SECRET, WEBHOOK_SECRET) are NOT stored here;
// they stay in the Cloudflare dashboard and are kept on every deploy.
{
  "name": "silent-disk-e913",
  "main": "worker.js",
  "compatibility_date": "2026-10-01",

  // the database the bot keeps chats, streamers and settings in
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "kickbot",
      "database_id": "ec54384d-b1f6-4876-b3a1-ef7aded251ee"
    }
  ],

  // run the live checks every minute
  "triggers": { "crons": ["* * * * *"] },

  "observability": { "enabled": true }
}
